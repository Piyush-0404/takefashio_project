DATABASE_URL="postgresql://postgres:<password>@localhost:5432/takefashion?schema=public"
JWT_SECRET="development-only-change-this-secret"
JWT_EXPIRES_IN="7d"
COOKIE_SECURE="True"
# Public Razorpay key returned to Checkout by the server.
RAZORPAY_KEY_ID=""
# Server-only secret for Razorpay API calls and payment signature verification.
RAZORPAY_KEY_SECRET=""
# Server-only secret used to verify Razorpay webhook requests.
RAZORPAY_WEBHOOK_SECRET=""
NEXT_PUBLIC_API_URL="http://localhost:3000"
VITE_API_BASE_URL="http://localhost:3000"
ADMIN_NAME="TakeFashion Admin"
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="replace-with-a-strong-admin-password"
EMAIL_PROVIDER="smtp"
EMAIL_HOST="smtp.example.com"
EMAIL_PORT="587"
EMAIL_USER=""
EMAIL_PASSWORD=""
EMAIL_FROM="TakeFashion <no-reply@example.com>"
OTP_EXPIRY_MINUTES="10"
OTP_MAX_ATTEMPTS="5"
OTP_RESEND_COOLDOWN_SECONDS="60"

