{
  "info": {
    "name": "TakeFashion Backend API",
    "description": "Complete TakeFashion customer and admin API collection. Set baseUrl, then run login before protected requests.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:3000" },
    { "key": "testEmail", "value": "customer@example.com" },
    { "key": "testPassword", "value": "Password123!" },
    { "key": "adminEmail", "value": "admin@example.com" },
    { "key": "adminPassword", "value": "replace-with-admin-password" },
    { "key": "productId", "value": "" },
    { "key": "cartItemId", "value": "" },
    { "key": "wishlistItemId", "value": "" },
    { "key": "orderId", "value": "" },
    { "key": "categoryId", "value": "" },
    { "key": "variantId", "value": "" },
    { "key": "couponId", "value": "" },
    { "key": "offerId", "value": "" },
    { "key": "userId", "value": "" }
  ],
  "item": [
    {
      "name": "Health",
      "item": [
        { "name": "Backend status", "request": { "method": "GET", "url": "{{baseUrl}}/" } }
      ]
    },
    {
      "name": "Customer Authentication",
      "item": [
        { "name": "Register", "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"name\": \"Test Customer\",\n  \"email\": \"{{testEmail}}\",\n  \"password\": \"{{testPassword}}\"\n}" }, "url": "{{baseUrl}}/api/auth/register" } },
        { "name": "Login", "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"email\": \"{{testEmail}}\",\n  \"password\": \"{{testPassword}}\"\n}" }, "url": "{{baseUrl}}/api/auth/login" } },
        { "name": "Current user", "request": { "method": "GET", "url": "{{baseUrl}}/api/auth/me" } },
        { "name": "Logout", "request": { "method": "POST", "url": "{{baseUrl}}/api/auth/logout" } }
      ]
    },
    {
      "name": "Catalog",
      "item": [
        { "name": "List products", "event": [{ "listen": "test", "script": { "exec": ["const body = pm.response.json();", "if (body.products?.[0]) pm.collectionVariables.set('productId', body.products[0].id);"] } }], "request": { "method": "GET", "url": "{{baseUrl}}/api/products?page=1&limit=20&sort=newest" } },
        { "name": "Filtered products", "request": { "method": "GET", "url": "{{baseUrl}}/api/products?category=women&min_price=300&max_price=3000&size=M&color=Black&sort=price_asc&page=1&limit=20" } },
        { "name": "Product by ID", "request": { "method": "GET", "url": "{{baseUrl}}/api/products/{{productId}}" } },
        { "name": "Product by slug", "request": { "method": "GET", "url": "{{baseUrl}}/api/products/slug/linen-relaxed-shirt" } },
        { "name": "Categories", "request": { "method": "GET", "url": "{{baseUrl}}/api/categories" } },
        { "name": "Category detail", "request": { "method": "GET", "url": "{{baseUrl}}/api/categories/women" } },
        { "name": "Category children", "request": { "method": "GET", "url": "{{baseUrl}}/api/categories/women/children" } },
        { "name": "Featured", "request": { "method": "GET", "url": "{{baseUrl}}/api/products/featured" } },
        { "name": "Trending", "request": { "method": "GET", "url": "{{baseUrl}}/api/products/trending" } },
        { "name": "New arrivals", "request": { "method": "GET", "url": "{{baseUrl}}/api/products/new-arrivals" } }
      ]
    },
    {
      "name": "Cart and Wishlist",
      "item": [
        { "name": "Add cart item", "event": [{ "listen": "test", "script": { "exec": ["const body = pm.response.json();", "if (body.item?.id) pm.collectionVariables.set('cartItemId', body.item.id);"] } }], "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"productId\": \"{{productId}}\",\n  \"quantity\": 1\n}" }, "url": "{{baseUrl}}/api/cart/items" } },
        { "name": "Get cart", "request": { "method": "GET", "url": "{{baseUrl}}/api/cart" } },
        { "name": "Update cart item", "request": { "method": "PATCH", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"quantity\": 2\n}" }, "url": "{{baseUrl}}/api/cart/items/{{cartItemId}}" } },
        { "name": "Remove cart item", "request": { "method": "DELETE", "url": "{{baseUrl}}/api/cart/items/{{cartItemId}}" } },
        { "name": "Clear cart", "request": { "method": "DELETE", "url": "{{baseUrl}}/api/cart" } },
        { "name": "Add wishlist item", "event": [{ "listen": "test", "script": { "exec": ["const body = pm.response.json();", "if (body.item?.id) pm.collectionVariables.set('wishlistItemId', body.item.id);"] } }], "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"productId\": \"{{productId}}\"\n}" }, "url": "{{baseUrl}}/api/wishlist/items" } },
        { "name": "Get wishlist", "request": { "method": "GET", "url": "{{baseUrl}}/api/wishlist" } },
        { "name": "Remove wishlist item", "request": { "method": "DELETE", "url": "{{baseUrl}}/api/wishlist/items/{{wishlistItemId}}" } },
        { "name": "Clear wishlist", "request": { "method": "DELETE", "url": "{{baseUrl}}/api/wishlist" } }
      ]
    },
    {
      "name": "Addresses Orders Payments",
      "item": [
        { "name": "List addresses", "request": { "method": "GET", "url": "{{baseUrl}}/api/addresses" } },
        { "name": "Create address", "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"fullName\": \"Test Customer\",\n  \"phone\": \"9876543210\",\n  \"addressLine1\": \"10 Fashion Street\",\n  \"city\": \"Mumbai\",\n  \"state\": \"Maharashtra\",\n  \"postalCode\": \"400001\",\n  \"country\": \"India\",\n  \"isDefault\": true\n}" }, "url": "{{baseUrl}}/api/addresses" } },
        { "name": "Create checkout order", "event": [{ "listen": "test", "script": { "exec": ["const body = pm.response.json();", "if (body.order?.id) pm.collectionVariables.set('orderId', body.order.id);"] } }], "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"shippingAddress\": {\n    \"name\": \"Test Customer\",\n    \"phone\": \"9876543210\",\n    \"line1\": \"10 Fashion Street\",\n    \"city\": \"Mumbai\",\n    \"state\": \"Maharashtra\",\n    \"postalCode\": \"400001\",\n    \"country\": \"India\"\n  }\n}" }, "url": "{{baseUrl}}/api/orders" } },
        { "name": "Order history", "request": { "method": "GET", "url": "{{baseUrl}}/api/orders" } },
        { "name": "Order detail", "request": { "method": "GET", "url": "{{baseUrl}}/api/orders/{{orderId}}" } },
        { "name": "Cancel order", "request": { "method": "PATCH", "url": "{{baseUrl}}/api/orders/{{orderId}}/cancel" } },
        { "name": "Create Razorpay order", "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"orderId\": \"{{orderId}}\"\n}" }, "url": "{{baseUrl}}/api/payments/create-order" } },
        { "name": "Payment status", "request": { "method": "GET", "url": "{{baseUrl}}/api/payments/order/{{orderId}}" } },
        { "name": "Validate coupon", "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"code\": \"WELCOME10\",\n  \"subtotal\": 1500\n}" }, "url": "{{baseUrl}}/api/coupons/validate" } }
      ]
    },
    {
      "name": "Admin",
      "description": "Run Admin login first. The login response stores an HTTP-only cookie used by admin routes.",
      "item": [
        { "name": "Admin login", "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"email\": \"{{adminEmail}}\",\n  \"password\": \"{{adminPassword}}\"\n}" }, "url": "{{baseUrl}}/api/auth/login" } },
        { "name": "Dashboard", "request": { "method": "GET", "url": "{{baseUrl}}/api/admin/dashboard" } },
        { "name": "List products", "event": [{ "listen": "test", "script": { "exec": ["const body = pm.response.json();", "if (body.products?.[0]) pm.collectionVariables.set('productId', body.products[0].id);"] } }], "request": { "method": "GET", "url": "{{baseUrl}}/api/admin/products" } },
        { "name": "Create product with four images", "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"name\": \"Admin Test Product\",\n  \"slug\": \"admin-test-product\",\n  \"description\": \"Product description and features.\",\n  \"categoryId\": \"{{categoryId}}\",\n  \"price\": 2499,\n  \"basePrice\": 2999,\n  \"gender\": \"UNISEX\",\n  \"images\": [\n    { \"imageUrl\": \"https://example.com/front.jpg\", \"altText\": \"Front\", \"isPrimary\": true, \"sortOrder\": 0 },\n    { \"imageUrl\": \"https://example.com/back.jpg\", \"altText\": \"Back\", \"sortOrder\": 1 },\n    { \"imageUrl\": \"https://example.com/side.jpg\", \"altText\": \"Side\", \"sortOrder\": 2 },\n    { \"imageUrl\": \"https://example.com/detail.jpg\", \"altText\": \"Detail\", \"sortOrder\": 3 }\n  ],\n  \"variants\": [\n    { \"sku\": \"TEST-M-BLACK\", \"size\": \"M\", \"color\": \"Black\", \"price\": 2499, \"stockQuantity\": 20 }\n  ]\n}" }, "url": "{{baseUrl}}/api/admin/products" } },
        { "name": "Update product", "request": { "method": "PATCH", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"description\": \"Updated features and description\",\n  \"price\": 2299,\n  \"isFeatured\": true\n}" }, "url": "{{baseUrl}}/api/admin/products/{{productId}}" } },
        { "name": "List categories", "event": [{ "listen": "test", "script": { "exec": ["const body = pm.response.json();", "if (body.categories?.[0]) pm.collectionVariables.set('categoryId', body.categories[0].id);"] } }], "request": { "method": "GET", "url": "{{baseUrl}}/api/admin/categories" } },
        { "name": "Create category", "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"name\": \"Summer Collection\",\n  \"slug\": \"summer-collection\",\n  \"description\": \"Seasonal category\",\n  \"sortOrder\": 10\n}" }, "url": "{{baseUrl}}/api/admin/categories" } },
        { "name": "List coupons", "request": { "method": "GET", "url": "{{baseUrl}}/api/admin/coupons" } },
        { "name": "Create coupon", "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"code\": \"WELCOME10\",\n  \"type\": \"PERCENTAGE\",\n  \"value\": 10,\n  \"minimumAmount\": 500,\n  \"maximumDiscount\": 500,\n  \"usageLimit\": 100,\n  \"startsAt\": \"2026-01-01T00:00:00.000Z\",\n  \"endsAt\": \"2027-12-31T23:59:59.000Z\"\n}" }, "url": "{{baseUrl}}/api/admin/coupons" } },
        { "name": "Update coupon", "request": { "method": "PATCH", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"value\": 15,\n  \"isActive\": true\n}" }, "url": "{{baseUrl}}/api/admin/coupons/{{couponId}}" } },
        { "name": "List offers", "request": { "method": "GET", "url": "{{baseUrl}}/api/admin/offers" } },
        { "name": "Create offer", "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"name\": \"Summer Sale\",\n  \"slug\": \"summer-sale\",\n  \"offerType\": \"PERCENTAGE\",\n  \"percentage\": 20,\n  \"startsAt\": \"2026-01-01T00:00:00.000Z\",\n  \"endsAt\": \"2027-12-31T23:59:59.000Z\",\n  \"productIds\": [\"{{productId}}\"],\n  \"categoryIds\": [\"{{categoryId}}\"]\n}" }, "url": "{{baseUrl}}/api/admin/offers" } },
        { "name": "List orders", "request": { "method": "GET", "url": "{{baseUrl}}/api/admin/orders" } },
        { "name": "List customers", "request": { "method": "GET", "url": "{{baseUrl}}/api/admin/users" } },
        { "name": "Update order status", "request": { "method": "PATCH", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"status\": \"PROCESSING\"\n}" }, "url": "{{baseUrl}}/api/admin/orders/{{orderId}}" } }
      ]
    }
  ]
}
